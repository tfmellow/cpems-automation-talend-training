    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//get date from your globalMap &#xD;&#xA;String dateVal = (String)globalMap.get(&quot;InputDate&quot;);&#xD;&#xA;&#xD;&#xA;String rawLogic  = input_row.COMPLIANCE_LOGIC;&#xD;&#xA;String rawReason = input_row.REASONS;&#xD;&#xA;String rawDesc   = input_row.BRIEF_DESCRIPTION;&#xD;&#xA;String rawAttach = input_row.ATTACHMENTS;&#xD;&#xA;&#xD;&#xA;String finalLogic  = (rawLogic == null)  ? &quot;NA&quot; : rawLogic.replace(&quot;[DATE]&quot;, dateVal);&#xD;&#xA;String finalReason = (rawReason == null) ? &quot;NA&quot; : rawReason.replace(&quot;[DATE]&quot;, dateVal);&#xD;&#xA;String finalDesc   = (rawDesc == null)   ? &quot;NA&quot; : rawDesc.replace(&quot;[DATE]&quot;, dateVal);&#xD;&#xA;String finalAttach = (rawAttach == null) ? &quot;NA&quot; : rawAttach.replace(&quot;[DATE]&quot;, dateVal);&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;current_logic&quot;, finalLogic);&#xD;&#xA;globalMap.put(&quot;current_reason&quot;, finalReason);&#xD;&#xA;globalMap.put(&quot;current_desc&quot;, finalDesc);&#xD;&#xA;globalMap.put(&quot;current_attach&quot;, finalAttach);&#xD;&#xA;globalMap.put(&quot;current_resource_id&quot;, input_row.RESOURCE_ID);&#xD;&#xA;&#xD;&#xA;output_row.PLANT_ENTITY      = input_row.PLANT_ENTITY;&#xD;&#xA;output_row.RESOURCE_ID       = input_row.RESOURCE_ID;&#xD;&#xA;output_row.COMPLIANCE_TYPE   = input_row.COMPLIANCE_TYPE;&#xD;&#xA;output_row.LOGIC_PRIORITY    = input_row.LOGIC_PRIORITY;&#xD;&#xA;output_row.COMPLIANCE_LOGIC  = finalLogic;&#xD;&#xA;output_row.ENTRY_TAG         = input_row.PLANT_ENTITY;&#xD;&#xA;output_row.REASONS           = finalReason;&#xD;&#xA;output_row.BRIEF_DESCRIPTION = finalDesc;&#xD;&#xA;output_row.ATTACHMENTS       = finalAttach;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;//String rawAttach = input_row.ATTACHMENTS;&#xD;&#xA;//String finalAttach = rawAttach.replace(&quot;[DATE]&quot;, (String)globalMap.get(&quot;InputDate&quot;));&#xD;&#xA;//&#xD;&#xA;//globalMap.put(&quot;current_logic&quot;, input_row.COMPLIANCE_LOGIC);&#xD;&#xA;//globalMap.put(&quot;current_reason&quot;, input_row.REASONS);&#xD;&#xA;//globalMap.put(&quot;current_desc&quot;, input_row.BRIEF_DESCRIPTION);&#xD;&#xA;//globalMap.put(&quot;current_attach&quot;, finalAttach);&#xD;&#xA;//globalMap.put(&quot;current_resource_id&quot;, input_row.RESOURCE_ID);&#xD;&#xA;//&#xD;&#xA;//&#xD;&#xA;//output_row.PLANT_ENTITY = input_row.PLANT_ENTITY;&#xD;&#xA;//output_row.RESOURCE_ID = input_row.RESOURCE_ID;&#xD;&#xA;//output_row.COMPLIANCE_TYPE = input_row.COMPLIANCE_TYPE;&#xD;&#xA;//output_row.LOGIC_PRIORITY = input_row.LOGIC_PRIORITY;&#xD;&#xA;//output_row.COMPLIANCE_LOGIC = input_row.COMPLIANCE_LOGIC;&#xD;&#xA;//output_row.ENTRY_TAG = input_row.PLANT_ENTITY;&#xD;&#xA;//output_row.REASONS = input_row.REASONS;&#xD;&#xA;//output_row.BRIEF_DESCRIPTION = input_row.BRIEF_DESCRIPTION;&#xD;&#xA;//output_row.ATTACHMENTS = finalAttach;&#xD;&#xA;&#xD;&#xA;"/>
