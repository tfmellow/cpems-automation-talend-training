  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="320" posY="520">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_2" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="// get first row data from columns Reasons, Brief_Description, and Date_From&#xD;&#xA;String reasons = input_row.Reasons;&#xD;&#xA;String briefDesc = input_row.Brief_Description;&#xD;&#xA;String dateFrom = input_row.Date_From;&#xD;&#xA;&#xD;&#xA;// if the following are not null and not &quot;Select Reason...&quot; or empty, it's tagged.&#xD;&#xA;boolean hasReasons = (reasons != null &amp;&amp; !reasons.trim().isEmpty() &amp;&amp; !reasons.contains(&quot;Select Reason&quot;));&#xD;&#xA;boolean hasBriefDesc = (briefDesc != null &amp;&amp; !briefDesc.trim().isEmpty());&#xD;&#xA;boolean hasDateFrom = (dateFrom != null &amp;&amp; !dateFrom.trim().isEmpty());&#xD;&#xA;&#xD;&#xA;if (hasReasons || hasBriefDesc || hasDateFrom) {&#xD;&#xA; globalMap.put(&quot;is_invalid_file&quot;, true);&#xD;&#xA; globalMap.put(&quot;error_reason&quot;, &quot;TAGGED FILE DETECTED: This file already contains tagging logic/descriptions. Try entering another input date.&quot;);&#xD;&#xA;} else {&#xD;&#xA; globalMap.put(&quot;is_invalid_file&quot;, false);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (globalMap.get(&quot;is_invalid_file&quot;) == null) {&#xD;&#xA;    globalMap.put(&quot;is_invalid_file&quot;, false);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// print validation&#xD;&#xA;System.out.println(&quot;Validation - Reasons: [&quot; + reasons + &quot;] | Is Tagged: &quot; + globalMap.get(&quot;is_invalid_file&quot;));"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_2"/>
  </node>
