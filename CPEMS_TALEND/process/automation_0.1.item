  <note opaque="false" posX="2800" posY="1040" sizeHeight="161" sizeWidth="881" text="TODO:&#xD;&#xA;fix logic for getting Seasonal_Maximum_Capability&#xD;&#xA;- results in null when my occ.Trading_Hour is 1/26/2026  00:00:00&#xD;&#xA;- fixed, checked the Date for CHEPP capability to also consider days that have 0 as 'H'&#xD;&#xA;&#xD;&#xA;used:&#xD;&#xA;Integer.parseInt(TalendDate.formatDate(&quot;H&quot;, occ.Trading_Hour)) == 0 ? 24 : Integer.parseInt(TalendDate.formatDate(&quot;H&quot;, occ.Trading_Hour))&#xD;&#xA;TalendDate.getPartOfDate(&quot;HOUR_OF_DAY&quot;, occ.Trading_Hour) ==  0 ? 24 : TalendDate.getPartOfDate(&quot;HOUR_OF_DAY&quot;, occ.Trading_Hour)&#xD;&#xA;Integer.parseInt(TalendDate.formatDate(&quot;HH&quot;, occ.Trading_Hour)) == 0 ? 24 : Integer.parseInt(TalendDate.formatDate(&quot;HH&quot;, occ.Trading_Hour))">
    <elementParameter field="RADIO" name="NOTETXT_LEFT" value="true"/>
    <elementParameter field="RADIO" name="NOTETXT_CENTER" value="false"/>
    <elementParameter field="RADIO" name="NOTELABEL_CENTER" value="false"/>
    <elementParameter field="RADIO" name="NOTETXT_TOP" value="true"/>
  </note>
  <note opaque="false" posX="2800" posY="880" sizeHeight="41" sizeWidth="601" text="TODO: Code to automatically find specific OCC file for the day (or specific day)">
    <elementParameter field="RADIO" name="NOTETXT_LEFT" value="true"/>
    <elementParameter field="RADIO" name="NOTETXT_CENTER" value="false"/>
    <elementParameter field="RADIO" name="NOTELABEL_CENTER" value="false"/>
    <elementParameter field="RADIO" name="NOTETXT_TOP" value="true"/>
  </note>
  <note opaque="true" posX="2800" posY="920" sizeHeight="81" sizeWidth="561" text="Improvements:&#xD;&#xA;- Check data types for efficiency &#xD;&#xA;- Should output have the extra column like the original CPEMS file&#xD;&#xA;- Automate the creation of the tables in Snowflake">
