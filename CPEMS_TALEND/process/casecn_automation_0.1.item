  <note opaque="false" posX="2520" posY="600" sizeHeight="161" sizeWidth="881" text="TODO:&#xD;&#xA;fix logic for getting Seasonal_Maximum_Capability&#xD;&#xA;- results in null when my occ.Trading_Hour is 1/26/2026  00:00:00&#xD;&#xA;- fixed, checked the Date for CHEPP capability to also consider days that have 0 as 'H'&#xD;&#xA;&#xD;&#xA;used:&#xD;&#xA;Integer.parseInt(TalendDate.formatDate(&quot;H&quot;, occ.Trading_Hour)) == 0 ? 24 : Integer.parseInt(TalendDate.formatDate(&quot;H&quot;, occ.Trading_Hour))&#xD;&#xA;TalendDate.getPartOfDate(&quot;HOUR_OF_DAY&quot;, occ.Trading_Hour) ==  0 ? 24 : TalendDate.getPartOfDate(&quot;HOUR_OF_DAY&quot;, occ.Trading_Hour)&#xD;&#xA;Integer.parseInt(TalendDate.formatDate(&quot;HH&quot;, occ.Trading_Hour)) == 0 ? 24 : Integer.parseInt(TalendDate.formatDate(&quot;HH&quot;, occ.Trading_Hour))">
    <elementParameter field="RADIO" name="NOTETXT_LEFT" value="true"/>
    <elementParameter field="RADIO" name="NOTETXT_CENTER" value="false"/>
    <elementParameter field="RADIO" name="NOTELABEL_CENTER" value="false"/>
    <elementParameter field="RADIO" name="NOTETXT_TOP" value="true"/>
  </note>
  <note opaque="false" posX="2520" posY="240" sizeHeight="40" sizeWidth="521" text="TODO: Code to automatically find specific OCC file for the day (or specific day)">
