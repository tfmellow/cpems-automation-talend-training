        <mapperTableEntries name="Date_From" expression="TalendDate.parseDate(&quot;yyyy-MM-dd HH:mm&quot;,TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, occ.Trading_Hour) + &quot; 01:00&quot;)" type="id_Date" nullable="true"/>
        <mapperTableEntries name="Date_To" expression="TalendDate.addDate(TalendDate.parseDate(&quot;yyyy-MM-dd HH:mm&quot;,TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, occ.Trading_Hour) + &quot; 00:00&quot;), 1, &quot;dd&quot;)" type="id_Date" nullable="true"/>
        <mapperTableEntries name="Brief_Description" expression="occ.Brief_Description  " type="id_String" nullable="true"/>
