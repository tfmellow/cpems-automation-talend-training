	  public static Integer getLogicId(
			  Float offered, 
			  Float registered, 
			  Float totalOffered, 
			  Integer seasonalMax, 
			  Boolean hasOutage) {
		
		// .equals is safe for Float objects
		if (offered.equals(registered)) {
			return 1;
		}
		
		else if (totalOffered <= seasonalMax && !hasOutage) {
			return 2;
		}
		
		// default
		return 0;
	}
}
