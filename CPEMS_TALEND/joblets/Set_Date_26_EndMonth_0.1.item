      <elementParameter field="MEMO_JAVA" name="CODE" value="if(TalendDate.isDate(context.parameter_InputDate, &quot;yyyyMM&quot;)) &#xA;{&#xA;&#x9;globalMap.put(&quot;StartDate&quot;, TalendDate.addDate(context.parameter_InputDate, &quot;yyyyMM&quot;, +0, &quot;MM&quot;) + &quot;26&quot;);&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;globalMap.put(&quot;EndDate&quot;, TalendDate.formatDate(&quot;yyyyMMdd&quot;, TalendDate.getLastDayOfMonth(TalendDate.parseDate(&quot;yyyyMMdd&quot;, &#x9;((String)globalMap.get(&quot;StartDate&quot;))))));&#xA;&#x9;&#xA;&#x9;globalMap.put(&quot;ForName&quot;, TalendDate.addDate(context.parameter_InputDate, &quot;yyyyMM&quot;, +0, &quot;MM&quot;) + &quot;26&quot;);&#xA;&#xA;&#x9;&#xA;}&#xA;&#xA;else&#xA;{&#xA;&#xA;&#x9;globalMap.put(&quot;S_Date&quot;,StringHandling.RIGHT(TalendDate.getDate(&quot;yyyyMMdd&quot;), 2));&#xA;&#xA;&#x9;if (Integer.parseInt(((String)globalMap.get(&quot;S_Date&quot;)))&lt;26)&#xA;&#x9;&#x9;{&#xA;&#x9;&#x9;globalMap.put(&quot;StartDate&quot;,TalendDate.addDate(TalendDate.getDate(&quot;yyyyMM&quot;), &quot;yyyyMM&quot;, -1, &quot;MM&quot;)+ &quot;26&quot;);&#xA;&#x9;&#xA;&#x9;&#x9;globalMap.put(&quot;EndDate&quot;, TalendDate.formatDate(&quot;yyyyMMdd&quot;, &#x9;&#x9;TalendDate.getLastDayOfMonth(TalendDate.parseDate(&quot;yyyyMMdd&quot;, ((String)globalMap.get(&quot;StartDate&quot;))))));&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;globalMap.put(&quot;ForName&quot;,TalendDate.addDate(TalendDate.getDate(&quot;yyyyMM&quot;), &quot;yyyyMM&quot;, -1, &quot;MM&quot;)+ &quot;26&quot;);&#xA;&#x9;}&#xA;&#x9;else&#xA;&#x9;{&#xA;&#x9;&#x9;globalMap.put(&quot;StartDate&quot;,TalendDate.addDate(TalendDate.getDate(&quot;yyyyMM&quot;), &quot;yyyyMM&quot;, +0, &quot;MM&quot;)+ &quot;26&quot;);&#xA;&#x9;&#xA;&#x9;&#x9;globalMap.put(&quot;EndDate&quot;, TalendDate.formatDate(&quot;yyyyMMdd&quot;, &#x9;&#x9;TalendDate.getLastDayOfMonth(TalendDate.parseDate(&quot;yyyyMMdd&quot;, ((String)globalMap.get(&quot;StartDate&quot;))))));&#xA;&#x9;&#x9;&#xA;&#x9;&#x