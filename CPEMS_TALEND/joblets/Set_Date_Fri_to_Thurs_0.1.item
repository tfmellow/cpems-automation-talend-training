    <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="384" posY="128">
      <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
      <elementParameter field="MEMO_JAVA" name="CODE" value="if(TalendDate.isDate(context.parameter_InputDate, &quot;yyyyMMdd&quot;)) &#xA;{&#xA;&#x9;globalMap.put(&quot;InputDate&quot;, context.parameter_InputDate);&#xA;}&#xA;&#xA;else&#xA;{&#xA;&#x9;globalMap.put(&quot;InputDate&quot;, TalendDate.getDate(&quot;yyyyMMdd&quot;));&#xA;}&#xA;&#xA;System.out.println(&quot;Input Date: &quot; + ((String)globalMap.get(&quot;InputDate&quot;)));&#xA;&#xA;String start_date = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;,TalendDate.parseDate(&quot;yyyyMMdd&quot;,TalendDate.addDate(((String)globalMap.get(&quot;InputDate&quot;)), &quot;yyyyMMdd&quot;, -7, &quot;dd&quot;)));&#xA;&#xA;globalMap.put(&quot;start_date&quot;, start_date);&#xA;&#xA;System.out.println(&quot;start date: &quot; + ((String)globalMap.get(&quot;start_date&quot;)));&#xA;&#xA;&#xA;String end_date = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;,TalendDate.parseDate(&quot;yyyyMMdd&quot;,TalendDate.addDate(((String)globalMap.get(&quot;InputDate&quot;)), &quot;yyyyMMdd&quot;, -1, &quot;dd&quot;)));&#xA;&#xA;globalMap.put(&quot;end_date&quot;, end_date);&#xA;&#xA;System.out.println(&quot;end date: &quot; + ((String)globalMap.get(&quot;end_date&quot;)));&#xA;&#xA;"/>
      <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
      <elementParameter field="TEXT" name="LABEL" value="Set Date"/>
      <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
      <metadata connector="FLOW" name="tJava_1"/>
